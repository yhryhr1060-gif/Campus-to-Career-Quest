# Copy this file to .env and fill in your own values. Never commit .env.

# --- Large language model (any OpenAI-compatible endpoint) ---
# 1 = mock mode: no API key needed, deterministic replies (used by tests and milestone 1)
LLM_MOCK=1

# DeepSeek example
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Choose a model that is available for your provider and account.
LLM_MODEL=deepseek-flash

# OpenAI example
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=30

# --- Optional local English speech recognition (round 4) ---
# Run setup-speech.cmd once after setup.cmd; installs requirements-speech.txt into backend/.venv
# and prepares about 661 MB of Parakeet CPU int8 model files in models/parakeet.
# Browser PCM WAV conversion does not require FFmpeg. Restart the backend after setup.
# parakeet = nemo-parakeet-tdt-0.6b-v2 (verified); canary is implemented but not yet validated.
ASR_BACKEND=parakeet
# Optional override, relative to project root or absolute; must resolve inside <project>/models.
# ASR_MODEL_DIR=models/parakeet

# --- Storage ---
# Defaults to <project>/data; SQLite state and event records go here.
# Audio is processed in memory, not saved. Original ASR text is stored only on manual Send.
# DATA_DIR=
